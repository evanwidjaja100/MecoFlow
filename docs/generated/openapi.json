            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Revoke the current server-side session",
        "tags": [
          "authentication"
        ]
      }
    },
