            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "403": {
            "description": "The active principal lacks permission or internal scope"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "List organization memberships and role assignments",
        "tags": [
          "administration"
        ]
      },
      "post": {
        "operationId": "AdministrationController_createMembership",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organizationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid"
            }
          }
        ],
