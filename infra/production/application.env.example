# Non-secret application settings only. Keep the deployed copy outside Git.
APP_ENV=production
NODE_ENV=production
APP_VERSION=replace-me
APP_TIMEZONE=Asia/Jakarta
APP_CURRENCY=IDR
WEB_BASE_URL=https://mecoflow.example.com
CORS_ORIGINS=https://mecoflow.example.com
OIDC_ISSUER=https://identity.example.com/realms/mecoflow
OIDC_CLIENT_ID=mecoflow-web
OIDC_REDIRECT_URI=https://mecoflow.example.com/api/v1/auth/callback
TRUST_PROXY_HOPS=1
DATABASE_HOST=replace-me
DATABASE_PORT=5432
DATABASE_NAME=mecoflow
DATABASE_USER=mecoflow
DATABASE_PASSWORD_FILE=/run/secrets/application-database-password
REDIS_HOST=replace-me
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/run/secrets/redis-password
S3_ENDPOINT=https://objects.example.com
S3_REGION=replace-me
S3_BUCKET=mecoflow-production-private
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_FILE=/run/secrets/s3-access-key
S3_SECRET_KEY_FILE=/run/secrets/s3-secret-key
S3_SERVER_SIDE_ENCRYPTION=aws:kms
S3_KMS_KEY_ID=replace-me
SESSION_SECRET_FILE=/run/secrets/session-secret
VIRUS_SCANNER_ENABLED=true
VIRUS_SCANNER_HOST=replace-me
VIRUS_SCANNER_PORT=3310
SMTP_ENABLED=false
LOG_LEVEL=info
