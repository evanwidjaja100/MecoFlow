{
  "name": "@mecoflow/readiness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./material-requirement-status": {
      "types": "./src/material-requirement-status.ts",
      "default": "./dist/material-requirement-status.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@mecoflow/typescript-config": "workspace:*"
  }
}
