}

model BomImportRow {
  id              String              @id @default(uuid()) @db.Uuid
  bomImportId     String              @db.Uuid
  rowNumber       Int
  rawData         Json
  itemId          String?             @db.Uuid
  unitOfMeasureId String?             @db.Uuid
  quantity        Decimal?            @db.Decimal(30, 6)
  criticality     BomLineCriticality?
  notes           String              @default("") @db.VarChar(1000)
  errors          Json
  warnings        Json
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  bomImport       BomImport           @relation(fields: [bomImportId], references: [id], onDelete: Restrict)
  item            Item?               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  unitOfMeasure   UnitOfMeasure?      @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)

  @@unique([bomImportId, rowNumber])
  @@index([itemId])
  @@map("bom_import_rows")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @db.VarChar(100)
  aggregateType String       @db.VarChar(100)
  aggregateId   String       @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  lockedAt      DateTime?    @db.Timestamptz(3)
  processedAt   DateTime?    @db.Timestamptz(3)
  lastErrorCode String?      @db.VarChar(100)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
