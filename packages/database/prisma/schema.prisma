generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(100)
  value     String   @db.VarChar(500)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("system_metadata")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationType {
  INTERNAL
  SUPPLIER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  INTERNAL
  SUPPLIER
  ANY
}

enum ProjectState {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  CONTRIBUTOR
  VIEWER
  SUPPLIER
}

enum ProjectMemberStatus {
  ACTIVE
  INACTIVE
}

enum SpecificationDataType {
  TEXT
  NUMBER
  BOOLEAN
}

enum BomRevisionStatus {
  DRAFT
  IN_REVIEW
  RELEASED
  SUPERSEDED
  CANCELLED
}

enum BomLineCriticality {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum BomImportStatus {
  QUEUED
  PARSING
  READY
  FAILED
  CONFIRMED
}

enum StoredFileStatus {
  QUARANTINED
  VALIDATED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum NotificationType {
  READINESS_ALERT
  READINESS_REMINDER
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  SKIPPED
  DEAD_LETTER
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  CANCELLED
}

enum AdvanceShipmentNoticeStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
}

enum GoodsReceiptKind {
  RECEIPT
  CORRECTION
}

enum InventoryLotStatus {
  AWAITING_INSPECTION
  ACCEPTED
  CONDITIONALLY_ACCEPTED
  QUARANTINED
  REJECTED
}

enum ReceivingInspectionStatus {
  OPEN
  FINALIZED
}

enum ReceivingInspectionDisposition {
  ACCEPTED
  CONDITIONALLY_ACCEPTED
  QUARANTINED
  REJECTED
}

enum NcrStatus {
  DRAFT
  ISSUED
  SUPPLIER_RESPONDED
  CLOSED
  CANCELLED
}

enum NcrSourceType {
  PROJECT
  INVENTORY_LOT
  RECEIVING_INSPECTION
}

enum MaterialAllocationStatus {
  ALLOCATED
  RELEASED
  CONSUMED
}

enum ReadinessScopeType {
  PROJECT
  WORK_PACKAGE
}

enum ReadinessStatus {
  RED
  AMBER
  GREEN
  COMPLETE
}

enum InspectionCheckType {
  CHECKLIST
  MEASUREMENT
  CERTIFICATE
}

enum CertificateReviewDecision {
  ACCEPTED
  REJECTED
}

enum DocumentVersionStatus {
  QUARANTINED
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
  SCAN_FAILED
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

enum DocumentAssociationType {
  PROJECT
  WORK_PACKAGE
  BOM
  PURCHASE_REQUISITION
  PURCHASE_ORDER
  ADVANCE_SHIPMENT_NOTICE
  GOODS_RECEIPT
  RECEIVING_INSPECTION
}

model UserProfile {
  id                             String                            @id @default(uuid()) @db.Uuid
  issuer                         String                            @db.VarChar(500)
  subject                        String                            @db.VarChar(255)
  email                          String                            @db.VarChar(320)
  displayName                    String                            @db.VarChar(200)
  locale                         String                            @default("en") @db.VarChar(10)
  status                         UserStatus                        @default(ACTIVE)
  lastLoginAt                    DateTime?                         @db.Timestamptz(3)
  version                        Int                               @default(1)
  createdAt                      DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                          @updatedAt @db.Timestamptz(3)
  memberships                    Membership[]
  sessions                       Session[]
  assignedRoles                  MembershipRole[]                  @relation("RoleAssignedBy")
  auditEvents                    AuditEvent[]                      @relation("AuditActor")
  createdProjects                Project[]                         @relation("ProjectCreatedBy")
  addedProjectMembers            ProjectMember[]                   @relation("ProjectMemberAddedBy")
  projectTransitions             ProjectTransition[]               @relation("ProjectTransitionActor")
  createdItems                   Item[]                            @relation("ItemCreatedBy")
  createdBomRevisions            BomRevision[]                     @relation("BomRevisionCreatedBy")
  bomTransitions                 BomRevisionTransition[]           @relation("BomRevisionTransitionActor")
  requestedBomImports            BomImport[]                       @relation("BomImportRequestedBy")
  requestedRequisitions          PurchaseRequisition[]             @relation("PurchaseRequisitionRequester")
  approvedRequisitions           PurchaseRequisition[]             @relation("PurchaseRequisitionApprover")
  requisitionOverrides           PurchaseRequisitionLine[]         @relation("PurchaseRequisitionOverrideAuthorizer")
  requisitionTransitions         PurchaseRequisitionTransition[]   @relation("PurchaseRequisitionTransitionActor")
  createdPurchaseOrders          PurchaseOrder[]                   @relation("PurchaseOrderCreatedBy")
  createdPoRevisions             PurchaseOrderRevision[]           @relation("PurchaseOrderRevisionCreatedBy")
  purchaseOrderOverrides         PurchaseOrderAllocation[]         @relation("PurchaseOrderOverrideAuthorizer")
  purchaseOrderTransitions       PurchaseOrderTransition[]         @relation("PurchaseOrderTransitionActor")
  commitmentRevisions            SupplierCommitmentRevision[]      @relation("SupplierCommitmentSubmittedBy")
  createdShipmentNotices         AdvanceShipmentNotice[]           @relation("AdvanceShipmentNoticeCreatedBy")
  shipmentTransitions            AdvanceShipmentNoticeTransition[] @relation("AdvanceShipmentNoticeTransitionActor")
  createdGoodsReceipts           GoodsReceipt[]                    @relation("GoodsReceiptCreatedBy")
  postedGoodsReceipts            GoodsReceipt[]                    @relation("GoodsReceiptPostedBy")
  createdDocuments               Document[]                        @relation("DocumentCreatedBy")
  createdDocumentVersions        DocumentVersion[]                 @relation("DocumentVersionCreatedBy")
  reviewedDocumentVersions       DocumentVersion[]                 @relation("DocumentVersionReviewedBy")
  documentTransitions            DocumentVersionTransition[]       @relation("DocumentVersionTransitionActor")
  createdInspectionChecks        InspectionCheckDefinition[]       @relation("InspectionCheckDefinitionCreatedBy")
  createdInspections             ReceivingInspection[]             @relation("ReceivingInspectionCreatedBy")
  finalizedInspections           ReceivingInspection[]             @relation("ReceivingInspectionFinalizedBy")
  conditionalInspections         ReceivingInspection[]             @relation("ReceivingInspectionConditionalAuthorizer")
  createdNcrs                    Ncr[]                             @relation("NcrCreatedBy")
  issuedNcrs                     Ncr[]                             @relation("NcrIssuedBy")
  closedNcrs                     Ncr[]                             @relation("NcrClosedBy")
  cancelledNcrs                  Ncr[]                             @relation("NcrCancelledBy")
  ncrSupplierResponses           NcrSupplierResponse[]             @relation("NcrSupplierResponseSubmittedBy")
  ncrTransitions                 NcrTransition[]                   @relation("NcrTransitionActor")
  createdMaterialAllocations     MaterialAllocation[]              @relation("MaterialAllocationCreatedBy")
  conditionalMaterialAllocations MaterialAllocation[]              @relation("MaterialAllocationConditionalAuthorizer")
  releasedMaterialAllocations    MaterialAllocation[]              @relation("MaterialAllocationReleasedBy")
  consumedMaterialAllocations    MaterialAllocation[]              @relation("MaterialAllocationConsumedBy")
  materialAllocationTransitions  MaterialAllocationTransition[]    @relation("MaterialAllocationTransitionActor")
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]

  @@unique([issuer, subject])
  @@index([email])
  @@map("user_profiles")
}

model Organization {
  id                  String                       @id @default(uuid()) @db.Uuid
  code                String                       @unique @db.VarChar(50)
  name                String                       @db.VarChar(200)
  type                OrganizationType
  active              Boolean                      @default(true)
  version             Int                          @default(1)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)
  memberships         Membership[]
  auditEvents         AuditEvent[]
  projects            Project[]
  bomImports          BomImport[]
  purchaseOrders      PurchaseOrder[]
  supplierCommitments SupplierCommitmentRevision[]
  shipmentNotices     AdvanceShipmentNotice[]
  documents           Document[]
  ncrs                Ncr[]

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           UserProfile      @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles          MembershipRole[]
  projectMembers ProjectMember[]

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@map("memberships")
}

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(150)
  description String    @default("") @db.VarChar(500)
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  projects    Project[]

  @@index([active, name])
  @@map("product_categories")
}

model Project {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @db.Uuid
  productCategoryId    String                  @db.Uuid
  code                 String                  @db.VarChar(50)
  name                 String                  @db.VarChar(200)
  description          String                  @default("") @db.VarChar(2000)
  state                ProjectState            @default(DRAFT)
  plannedStartDate     DateTime                @db.Date
  plannedEndDate       DateTime                @db.Date
  version              Int                     @default(1)
  createdByUserId      String                  @db.Uuid
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productCategory      ProductCategory         @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)
  createdBy            UserProfile             @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members              ProjectMember[]
  milestones           Milestone[]
  workPackages         WorkPackage[]
  transitions          ProjectTransition[]
  boms                 Bom[]
  bomImports           BomImport[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  shipmentNotices      AdvanceShipmentNotice[]
  goodsReceipts        GoodsReceipt[]
  inventoryLots        InventoryLot[]
  receivingInspections ReceivingInspection[]
  documents            Document[]
  ncrs                 Ncr[]
  materialAllocations  MaterialAllocation[]
  readinessSnapshots   ReadinessSnapshot[]
  notifications        Notification[]

  @@unique([organizationId, code])
  @@index([organizationId, state, updatedAt])
  @@index([productCategoryId, state])
  @@map("projects")
}

model ProjectMember {
  id            String              @id @default(uuid()) @db.Uuid
  projectId     String              @db.Uuid
  membershipId  String              @db.Uuid
  role          ProjectMemberRole
  status        ProjectMemberStatus @default(ACTIVE)
  version       Int                 @default(1)
  addedByUserId String              @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  membership    Membership          @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  addedBy       UserProfile         @relation("ProjectMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@unique([projectId, membershipId])
  @@index([membershipId, status])
  @@map("project_members")
}

model Milestone {
  id           String        @id @default(uuid()) @db.Uuid
  projectId    String        @db.Uuid
  code         String        @db.VarChar(50)
  name         String        @db.VarChar(200)
  description  String        @default("") @db.VarChar(1000)
  targetDate   DateTime      @db.Date
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackages WorkPackage[]

  @@unique([projectId, code])
  @@index([projectId, targetDate])
  @@map("milestones")
}

model WorkPackage {
  id                 String              @id @default(uuid()) @db.Uuid
  projectId          String              @db.Uuid
  milestoneId        String?             @db.Uuid
  code               String              @db.VarChar(50)
  name               String              @db.VarChar(200)
  description        String              @default("") @db.VarChar(1000)
  plannedStartDate   DateTime            @db.Date
  plannedEndDate     DateTime            @db.Date
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  milestone          Milestone?          @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  boms               Bom[]
  bomImports         BomImport[]
  readinessSnapshots ReadinessSnapshot[]

  @@unique([projectId, code])
  @@unique([id, projectId])
  @@index([projectId, plannedStartDate])
  @@index([milestoneId])
  @@map("work_packages")
}

model ProjectTransition {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @db.Uuid
  actorUserId String       @db.Uuid
  sourceState ProjectState
  targetState ProjectState
  reason      String       @db.VarChar(500)
  occurredAt  DateTime     @default(now()) @db.Timestamptz(3)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor       UserProfile  @relation("ProjectTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([projectId, occurredAt])
  @@map("project_transitions")
}

model ItemCategory {
  id                      String                             @id @default(uuid()) @db.Uuid
  code                    String                             @unique @db.VarChar(50)
  name                    String                             @db.VarChar(150)
  description             String                             @default("") @db.VarChar(500)
  active                  Boolean                            @default(true)
  version                 Int                                @default(1)
  createdAt               DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                           @updatedAt @db.Timestamptz(3)
  specificationAttributes SpecificationAttributeDefinition[]
  items                   Item[]

  @@index([active, name])
  @@map("item_categories")
}

model UnitOfMeasure {
  id                      String                             @id @default(uuid()) @db.Uuid
  code                    String                             @unique @db.VarChar(30)
  name                    String                             @db.VarChar(100)
  symbol                  String                             @db.VarChar(20)
  decimalPrecision        Int                                @default(0)
  active                  Boolean                            @default(true)
  version                 Int                                @default(1)
  createdAt               DateTime                           @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                           @updatedAt @db.Timestamptz(3)
  items                   Item[]
  specificationAttributes SpecificationAttributeDefinition[]
  bomLines                BomLine[]
  bomImportRows           BomImportRow[]
  purchaseOrderLines      PurchaseOrderLine[]
  inventoryLots           InventoryLot[]
  inspectionDefinitions   InspectionCheckDefinition[]
  inspectionChecks        ReceivingInspectionCheck[]

  @@index([active, name])
  @@map("units_of_measure")
}

model SpecificationAttributeDefinition {
  id                  String                   @id @default(uuid()) @db.Uuid
  itemCategoryId      String                   @db.Uuid
  code                String                   @db.VarChar(50)
  name                String                   @db.VarChar(150)
  description         String                   @default("") @db.VarChar(500)
  dataType            SpecificationDataType
  required            Boolean                  @default(false)
  unitOfMeasureId     String?                  @db.Uuid
  decimalPrecision    Int?
  sortOrder           Int                      @default(0)
  active              Boolean                  @default(true)
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  itemCategory        ItemCategory             @relation(fields: [itemCategoryId], references: [id], onDelete: Restrict)
  unitOfMeasure       UnitOfMeasure?           @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  specificationValues ItemSpecificationValue[]

  @@unique([itemCategoryId, code])
  @@index([itemCategoryId, active, sortOrder])
  @@index([unitOfMeasureId])
  @@map("specification_attribute_definitions")
}

model Item {
  id                    String                      @id @default(uuid()) @db.Uuid
  code                  String                      @unique @db.VarChar(50)
  name                  String                      @db.VarChar(200)
  description           String                      @default("") @db.VarChar(2000)
  itemCategoryId        String                      @db.Uuid
  unitOfMeasureId       String                      @db.Uuid
  active                Boolean                     @default(true)
  version               Int                         @default(1)
  createdByUserId       String                      @db.Uuid
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
  itemCategory          ItemCategory                @relation(fields: [itemCategoryId], references: [id], onDelete: Restrict)
  unitOfMeasure         UnitOfMeasure               @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  createdBy             UserProfile                 @relation("ItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  specificationValues   ItemSpecificationValue[]
  bomLines              BomLine[]
  bomImportRows         BomImportRow[]
  purchaseOrderLines    PurchaseOrderLine[]
  inventoryLots         InventoryLot[]
  inspectionDefinitions InspectionCheckDefinition[]

  @@index([active, code])
  @@index([itemCategoryId, active])
  @@index([unitOfMeasureId, active])
  @@map("items")
}

model ItemSpecificationValue {
  id                    String                           @id @default(uuid()) @db.Uuid
  itemId                String                           @db.Uuid
  attributeDefinitionId String                           @db.Uuid
  textValue             String?                          @db.VarChar(1000)
  numericValue          Decimal?                         @db.Decimal(30, 6)
  booleanValue          Boolean?
  createdAt             DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                         @updatedAt @db.Timestamptz(3)
  item                  Item                             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  attributeDefinition   SpecificationAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([itemId, attributeDefinitionId])
  @@index([attributeDefinitionId])
  @@map("item_specification_values")
}

model Role {
  code        String           @id @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String           @db.VarChar(500)
  scope       RoleScope
  system      Boolean          @default(true)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

model Permission {
  code        String           @id @db.VarChar(100)
  description String           @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String     @db.VarChar(50)
  permissionCode String     @db.VarChar(100)
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId     String       @db.Uuid
  roleCode         String       @db.VarChar(50)
  assignedByUserId String?      @db.Uuid
  assignedAt       DateTime     @default(now()) @db.Timestamptz(3)
  membership       Membership   @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role             Role         @relation(fields: [roleCode], references: [code], onDelete: Restrict)
  assignedBy       UserProfile? @relation("RoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleCode])
  @@index([assignedByUserId])
  @@map("membership_roles")
}

model Session {
  id            String      @id @default(uuid()) @db.Uuid
  tokenHash     String      @unique @db.Char(64)
  csrfTokenHash String      @db.Char(64)
  userId        String      @db.Uuid
  expiresAt     DateTime    @db.Timestamptz(3)
  revokedAt     DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime    @default(now()) @db.Timestamptz(3)
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OidcAuthTransaction {
  stateHash    String   @id @db.Char(64)
  codeVerifier String   @db.VarChar(128)
  nonce        String   @db.VarChar(128)
  returnTo     String   @db.VarChar(500)
  expiresAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("oidc_auth_transactions")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  occurredAt     DateTime      @default(now()) @db.Timestamptz(3)
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String        @db.VarChar(100)
  entityType     String        @db.VarChar(100)
  entityId       String        @db.VarChar(100)
  requestId      String        @db.VarChar(128)
  correlationId  String        @db.VarChar(128)
  outcome        String        @db.VarChar(30)
  changes        Json
  actor          UserProfile?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

model Bom {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  workPackageId String?       @db.Uuid
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workPackage   WorkPackage?  @relation(fields: [workPackageId], references: [id], onDelete: Restrict)
  revisions     BomRevision[]

  @@unique([projectId, workPackageId])
  @@index([projectId, updatedAt])
  @@map("boms")
}

model BomRevision {
  id              String                  @id @default(uuid()) @db.Uuid
  bomId           String                  @db.Uuid
  revisionNumber  Int
  status          BomRevisionStatus       @default(DRAFT)
  title           String                  @db.VarChar(200)
  notes           String                  @default("") @db.VarChar(2000)
  version         Int                     @default(1)
  sourceFileId    String?                 @db.Uuid
  sourceChecksum  String?                 @db.Char(64)
  sourceImportId  String?                 @unique @db.Uuid
  createdByUserId String                  @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  reviewedAt      DateTime?               @db.Timestamptz(3)
  releasedAt      DateTime?               @db.Timestamptz(3)
  supersededAt    DateTime?               @db.Timestamptz(3)
  cancelledAt     DateTime?               @db.Timestamptz(3)
  bom             Bom                     @relation(fields: [bomId], references: [id], onDelete: Restrict)
  sourceFile      StoredFile?             @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  sourceImport    BomImport?              @relation("ConfirmedBomRevision", fields: [sourceImportId], references: [id], onDelete: Restrict)
  createdBy       UserProfile             @relation("BomRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines           BomLine[]
  transitions     BomRevisionTransition[]

  @@unique([bomId, revisionNumber])
  @@index([bomId, status, updatedAt])
  @@map("bom_revisions")
}

model BomLine {
  id                  String                    @id @default(uuid()) @db.Uuid
  bomRevisionId       String                    @db.Uuid
  lineNumber          Int
  itemId              String                    @db.Uuid
  unitOfMeasureId     String                    @db.Uuid
