  scanStatus       VirusScanStatus             @default(PENDING)
  storageKey       String                      @unique @db.VarChar(500)
  originalFileName String                      @db.VarChar(255)
  extension        String                      @db.VarChar(10)
  declaredMimeType String                      @db.VarChar(150)
  detectedMimeType String?                     @db.VarChar(150)
  byteSize         Int
  sha256           String                      @db.Char(64)
  uploadExpiresAt  DateTime                    @db.Timestamptz(3)
  uploadedAt       DateTime?                   @db.Timestamptz(3)
  scannedAt        DateTime?                   @db.Timestamptz(3)
