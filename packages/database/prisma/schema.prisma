  createdBy        UserProfile                 @relation("DocumentVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reviewedBy       UserProfile?                @relation("DocumentVersionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
