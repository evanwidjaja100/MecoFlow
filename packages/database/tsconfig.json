{
  "extends": "@mecoflow/typescript-config/library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "generated/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts"
  ],
