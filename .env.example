# Local-development values only. Replace every credential outside local development.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Jakarta
APP_CURRENCY=IDR

WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_INTERNAL_URL=http://api:3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

POSTGRES_DB=mecoflow
POSTGRES_USER=mecoflow_local
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://mecoflow_local:local_only_change_me@localhost:5432/mecoflow?schema=public
DATABASE_URL_DOCKER=postgresql://mecoflow_local:local_only_change_me@postgres:5432/mecoflow?schema=public

REDIS_URL=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

MINIO_ROOT_USER=mecoflow_local
MINIO_ROOT_PASSWORD=local_only_minio_change_me
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mecoflow_local
S3_SECRET_KEY=local_only_minio_change_me
S3_BUCKET=mecoflow-private
S3_FORCE_PATH_STYLE=true
VIRUS_SCANNER_ENABLED=false
VIRUS_SCANNER_HOST=127.0.0.1
VIRUS_SCANNER_PORT=3310
VIRUS_SCANNER_TIMEOUT_MS=10000

KEYCLOAK_ADMIN=mecoflow_local_admin
KEYCLOAK_ADMIN_PASSWORD=local_only_keycloak_change_me
KEYCLOAK_HTTP_PORT=8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=mecoflow-local
KEYCLOAK_CLIENT_ID=mecoflow-web
OIDC_ISSUER=http://localhost:8180/realms/mecoflow-local
OIDC_CLIENT_ID=mecoflow-web
OIDC_REDIRECT_URI=http://localhost:3001/api/v1/auth/callback
WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=local_only_session_secret_change_me_32_chars
SESSION_TTL_SECONDS=28800

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
